{
  "name": "smarthub",
  "version": "1.0.0",
  "description": "Smart Hub - Content distribution for Dimsum Sewu",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev ./public",
    "deploy": "wrangler pages deploy ./public --project-name smarthub",
    "db:init": "wrangler d1 execute smarthub --file ./schema.sql",
    "db:remote": "wrangler d1 execute smarthub --remote --file ./schema.sql"
  },
  "dependencies": {
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
